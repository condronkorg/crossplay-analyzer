+emscripten::val simulateReviewMove(std::string gridJson, std::string rackStr, int playerScore, int oppScore,
+                                  int numMoves, int iterations, int bagCount, int finalTurnsRemaining,
+                                  emscripten::val played, unsigned int seed)
+{
+    emscripten::val result = emscripten::val::object();
+    result.set("moves", emscripten::val::array());
+    result.set("simulated", false);
+    result.set("seed", seed);
+    result.set("samplingVersion", std::string("paired-review-v1"));
+    try
+    {
+        if (!s_dm || !s_dm->isGood()) throw std::invalid_argument("Engine not initialized");
+        if (numMoves < 1 || numMoves > 15) throw std::invalid_argument("Review candidate count must be between 1 and 15");
+        if (iterations < 1 || iterations > 277) throw std::invalid_argument("Simulation iterations must be between 1 and 277");
+        s_dm->seedRandomNumbers(seed);
+        Quackle::Game game;
+        std::string error;
+        if (!prepareGame(gridJson, rackStr, playerScore, oppScore, numMoves,
+                         bagCount, finalTurnsRemaining, true, game, &error))
+            throw std::invalid_argument(error);
+        Quackle::GamePosition &pos = game.currentPosition();
+        const Quackle::Rack rack = pos.currentPlayer().rack();
+        Quackle::Move actual = recordedMove(pos, played);
+        const std::string actualKey = physicalMoveKey(actual);
+        Quackle::MoveList candidates = pos.moves();
+        bool found = false;
+        for (const auto &move : candidates)
+        {
+            if (physicalMoveKey(move) == actualKey) { actual = move; found = true; break; }
+        }
+        if (!found) candidates.push_back(actual);
+        const bool playToEnd = bagCount <= 21;
+        const int plies = playToEnd ? -1 : 2;
+        Quackle::Simulator simulator;
+        simulator.setThreadCount(0);
+        simulator.setPosition(pos);
+        simulator.setIncludedMoves(candidates);
+        simulator.setPairedSampleSeed(seed);
+        simulator.setIgnoreOppos(false);
+        simulator.simulate(plies, iterations);
+        const auto moves = simulator.moves(true, true);
+        auto serialized = serializeMoves(moves, rack, &simulator);
+        bool allTerminal = true;
+        double bestStaticEquity = candidates.front().equity;
+        for (const auto &move : candidates) bestStaticEquity = std::max(bestStaticEquity, move.equity);
+        for (size_t i = 0; i < moves.size(); ++i)
+        {
+            const auto &simmed = simulator.simmedMoveForMove(moves[i]);
+            serialized[(unsigned int)i].set("staticEquity", simmed.move.equity);
+            if (physicalMoveKey(moves[i]) == actualKey) result.set("selected", serialized[(unsigned int)i]);
+            if (serialized[(unsigned int)i]["terminalSamples"].as<int>() != iterations) allTerminal = false;
+        }
+        const int completed = simulator.iterations();
+        result.set("moves", serialized);
+        result.set("best", serialized[0]);
+        result.set("staticMoves", serializeMoves(candidates, rack, nullptr));
+        result.set("bestStaticEquity", bestStaticEquity);
+        result.set("simulated", completed == iterations && (!playToEnd || allTerminal));
+        result.set("iterationsRequested", iterations);
+        result.set("iterationsCompleted", completed);
+        result.set("candidateCount", (int)moves.size());
+        result.set("totalPlayaheads", completed * (int)moves.size());
+        result.set("bagCount", bagCount);
+        result.set("finalTurnsRemaining", finalTurnsRemaining);
+        result.set("plies", plies);
+        result.set("playToEnd", playToEnd);
+        result.set("simulationMode", std::string(playToEnd ? "play-to-end" : "2-ply"));
+        result.set("winModel", std::string(playToEnd ? "terminal" : "bogowin"));
+        result.set("error", playToEnd && !allTerminal
+            ? std::string("A sampled endgame did not reach the official Crossplay finish") : std::string(""));
+    }
+    catch (const std::exception &error) { result.set("error", std::string(error.what())); }
+    return result;
+}
