+        simulator.setIncludedMoves(candidates);
+        simulator.setPairedSampleSeed(seed);
+        simulator.setIgnoreOppos(false);
+        simulator.simulate(plies, iterations);
+        const auto moves = simulator.moves(true, true);
+        auto serialized = serializeMoves(moves, rack, &simulator);
+        bool allTerminal = true;
+        double bestStaticEquity = candidates.front().equity;
+        for (const auto &move : candidates) bestStaticEquity = std::max(bestStaticEquity, move.equity);
+        for (size_t i = 0; i < moves.size(); ++i)
+        {
+            const auto &simmed = simulator.simmedMoveForMove(moves[i]);
+            serialized[(unsigned int)i].set("staticEquity", simmed.move.equity);
+            if (physicalMoveKey(moves[i]) == actualKey) result.set("selected", serialized[(unsigned int)i]);
+            if (serialized[(unsigned int)i]["terminalSamples"].as<int>() != iterations) allTerminal = false;
+        }
+        const int completed = simulator.iterations();
+        result.set("moves", serialized);
+        result.set("best", serialized[0]);
+        result.set("staticMoves", serializeMoves(candidates, rack, nullptr));
+        result.set("bestStaticEquity", bestStaticEquity);
+        result.set("simulated", completed == iterations && (!playToEnd || allTerminal));
+        result.set("iterationsRequested", iterations);
+        result.set("iterationsCompleted", completed);
+        result.set("candidateCount", (int)moves.size());
+        result.set("totalPlayaheads", completed * (int)moves.size());
+        result.set("bagCount", bagCount);
+        result.set("finalTurnsRemaining", finalTurnsRemaining);
+        result.set("plies", plies);
+        result.set("playToEnd", playToEnd);
+        result.set("simulationMode", std::string(playToEnd ? "play-to-end" : "2-ply"));
+        result.set("winModel", std::string(playToEnd ? "terminal" : "bogowin"));
+        if (playToEnd) result.set("endgamePolicy", std::string("crossplay-endgame-v3"));
+        result.set("error", playToEnd && !allTerminal
+            ? std::string("A sampled endgame did not reach the official Crossplay finish") : std::string(""));
+    }
+    catch (const std::exception &error) { result.set("error", std::string(error.what())); }
+    return result;
+}
+
+emscripten::val planBagEmptying(
+	std::string gridJson, std::string rackStr, int playerScore, int oppScore, emscripten::val played, unsigned int seed)
+{
+	auto result = emscripten::val::object();
+	try
+	{
+		if (!s_dm || !s_dm->isGood())
+			throw std::invalid_argument("Engine not initialized");
+		s_dm->seedRandomNumbers(seed);
+		Quackle::Game game;
+		std::string error;
+		if (!prepareGame(gridJson, rackStr, playerScore, oppScore, 1000000, -1, 0, false, game, &error))
+			throw std::invalid_argument(error);
+		auto &pos = game.currentPosition();
+		const int bag = pos.bag().size();
+		if (bag < 1 || bag > 7 || pos.moves().size() >= 1000000)
+			throw std::invalid_argument("Bag-emptying search requires a complete low-bag move list");
+		const auto rack = pos.currentPlayer().rack();
+		Quackle::MoveList candidates;
+		Quackle::MoveList equityMoves;
+		std::vector<std::string> keys;
+		auto add = [&](const Quackle::Move &move) {
+			const std::string key = physicalMoveKey(move);
+			if (std::find(keys.begin(), keys.end(), key) == keys.end())
+			{
+				candidates.push_back(move);
+				keys.push_back(key);
+			}
+		};
+		int staticCount = 0;
+        int totalBagEmptying = 0;
+        int generated = 0;
+		for (const auto &move : pos.moves())
+		{
+			if (move.action == Quackle::Move::Exchange && move.tiles().size() > (size_t)bag)
+				continue;
+			const bool empties = move.action == Quackle::Move::Place && (int)rack.size() - (int)(rack - move).size() >= bag;
+			if (staticCount++ < 15)
+			{
+				equityMoves.push_back(move);
+				add(move);
+			}
+            if (empties) ++totalBagEmptying;
+            ++generated;
+		}
+		int actualIndex = -1;
+		if (!played.isNull() && !played.isUndefined())
+		{
+			auto actual = recordedMove(pos, played);
+			add(actual);
+			const auto key = physicalMoveKey(actual);
+			if (std::none_of(
+					equityMoves.begin(), equityMoves.end(), [&](const Quackle::Move &move) { return physicalMoveKey(move) == key; }))
+				equityMoves.push_back(actual);
+			actualIndex = std::find(keys.begin(), keys.end(), key) - keys.begin();
+		}
+		auto indices = emscripten::val::array();
+		int count = 0;
+		for (size_t i = 0; i < candidates.size(); ++i)
+			if (candidates[i].action == Quackle::Move::Place && (int)rack.size() - (int)(rack - candidates[i]).size() >= bag)
+				indices.set(count++, (int)i);
+		result.set("moves", serializeMoves(candidates, rack, nullptr));
+		result.set("equityMoves", serializeMoves(equityMoves, rack, nullptr));
+		result.set("bagEmptyingIndices", indices);
+        result.set("generatedCandidateCount", generated);
+        result.set("totalBagEmptyingCount", totalBagEmptying);
+		result.set("tieOrder", nativeTieOrder(candidates));
+		result.set("actualIndex", actualIndex);
+		result.set("seed", seed);
+		result.set("bagCount", bag);
+		result.set("finalTurnsRemaining", 0);
+		result.set("error", std::string(""));
+	}
+	catch (const std::exception &error)
+	{
+		result.set("error", std::string(error.what()));
+	}
+	return result;
+}
+
+constexpr double batchBudgetMs = 8000;
+
+bool validBatchRange(double offset, double count)
+{
+    return std::isfinite(count) && count >= 1 && count <= 16 && std::floor(count) == count
+        && std::isfinite(offset) && offset >= 0 && offset <= 277 - count && std::floor(offset) == offset;
+}
+
+unsigned int shiftedSampleSeed(unsigned int seed, int offset)
+{
+    // Trial numbers start at one inside Simulator, so shift the base seed.
+    return seed + 0x9e3779b9u * static_cast<unsigned int>(offset);
+}
+
+emscripten::val simulateCandidateBatchImpl(std::string gridJson, std::string rackStr, int playerScore, int oppScore, int bagCount,
+    int finalTurnsRemaining, emscripten::val candidates, unsigned int seed, double offsetValue, double countValue, bool legacy)
+{
+	auto result = emscripten::val::object();
+	try
+	{
+		if (!s_dm || !s_dm->isGood()) throw std::invalid_argument("Engine not initialized");
+		if (!legacy && !emscripten::val::global("Array").call<bool>("isArray", candidates))
+			throw std::invalid_argument("Review candidates must be an array");
+		const int size = candidates["length"].as<int>();
+		if (size < 1 || size > 8 || !validBatchRange(offsetValue, countValue)
+			|| (legacy ? bagCount < 1 || bagCount > 7 : bagCount < 0 || bagCount > 21))
+			throw std::invalid_argument("Invalid candidate batch bounds");
+		const int offset = static_cast<int>(offsetValue);
+		const int count = static_cast<int>(countValue);
+		s_dm->seedRandomNumbers(seed);
+		Quackle::Game game;
+		std::string error;
+		if (!prepareGame(gridJson, rackStr, playerScore, oppScore, 1, bagCount, finalTurnsRemaining, true, game, &error, legacy))
+			throw std::invalid_argument(error);
+		auto &pos = game.currentPosition();
+		const auto rack = pos.currentPlayer().rack();
+		Quackle::MoveList moves;
+		for (int i = 0; i < size; ++i)
+			moves.push_back(recordedMove(pos, candidates[i]));
+		Quackle::Simulator simulator;
+		simulator.setThreadCount(0);
+		simulator.setPosition(pos);
+		simulator.setIncludedMoves(moves);
+		simulator.setPairedSampleSeed(shiftedSampleSeed(seed, offset));
+		simulator.setIgnoreOppos(false);
+		const double start = emscripten_get_now();
+		int completed = 0;
+		do
+		{
+			simulator.simulate(-1, 1);
+			++completed;
+		} while (completed < count && emscripten_get_now() - start < batchBudgetMs);
+		auto serialized = emscripten::val::array();
+		for (int i = 0; i < size; ++i)
+		{
+			Quackle::MoveList single;
+			single.push_back(moves[i]);
+			auto item = serializeMoves(single, rack, &simulator)[0];
+			const auto &simmed = simulator.simmedMoveForMove(moves[i]);
+			auto statistics = emscripten::val::array();
+			int statisticIndex = 0;
+			for (size_t level = 0; level < simmed.levels.size(); ++level)
+				for (size_t player = 0; player < simmed.levels[level].statistics.size(); ++player)
+				{
+					const auto &score = simmed.levels[level].statistics[player].score;
+					const int samples = score.incorporatedValues();
+					if (!samples)
+						continue;
+					auto entry = emscripten::val::array();
+					entry.set(0, (int)level);
+					entry.set(1, (int)player);
+					entry.set(2, legacy ? score.averagedValue() * samples : static_cast<double>(score.valueSum()));
+					entry.set(3, samples);
+					statistics.set(statisticIndex++, entry);
+				}
+			item.set("equityStatistics", statistics);
+			item.set("residualSum", legacy ? simmed.residual.averagedValue() * completed
+				: static_cast<double>(simmed.residual.valueSum()));
+			if (!legacy)
+			{
+				if (simmed.wins.incorporatedValues() != completed || simmed.terminalResults.valueSum() != completed)
+					throw std::invalid_argument("A sampled endgame did not reach the official Crossplay finish");
+				item.set("winSum", static_cast<double>(simmed.wins.valueSum()));
+			}
+			item.set("equity", simmed.calculateEquity());
+			item.set("win", simmed.wins.averagedValue());
+			serialized.set(i, item);
+		}
+		result.set("moves", serialized);
+		result.set("completed", completed);
+		result.set("offset", offset);
+		result.set("error", std::string(""));
+	}
+	catch (const std::exception &error)
+	{
+		result.set("error", std::string(error.what()));
+	}
+	return result;
+}
