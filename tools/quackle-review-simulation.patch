+Move Generator::crossplayBestPlacement()
+{
+    setrecordall(false);
+    m_crossplayEquity = true;
+    m_crossplayLeaves.clear();
+    Move result;
+    try { result = findstaticbest(false); }
+    catch (...) { m_crossplayEquity = false; throw; }
+    m_crossplayEquity = false;
+    if (result.action != Move::Place)
+    {
+        // Rare no-placement path: a swap may make progress. Preserve the
+        // former exhaustive pass/exchange selection, rather than forcing pass.
+        Generator fallback(m_position);
+        fallback.kibitz(2, position().exchangeAllowed() ? RegularKibitz : CannotExchange);
+        MoveList all = fallback.allPossiblePlays();
+        if (std::none_of(all.begin(), all.end(), [](const Move &move) { return move.action == Move::Pass; }))
+            all.push_back(Move::createPassMove());
+        std::stable_sort(all.begin(), all.end(), [](const Move &a, const Move &b) {
+            if (a.equity != b.equity) return a.equity > b.equity;
+            if (a.score != b.score) return a.score > b.score;
+            if (a.action != b.action) return a.action < b.action;
+            if (a.startrow != b.startrow) return a.startrow < b.startrow;
+            if (a.startcol != b.startcol) return a.startcol < b.startcol;
+            if (a.horizontal != b.horizontal) return a.horizontal < b.horizontal;
+            return a.tiles() < b.tiles();
+        });
+        double bestValue = -std::numeric_limits<double>::infinity();
+        m_crossplayEquity = true;
+        for (const auto &move : all)
+        {
+            const double value = equity(move);
+            if (value > bestValue) { bestValue = value; result = move; }
+        }
+        m_crossplayEquity = false;
+    }
+    result.equity = QUACKLE_EVALUATOR->equity(m_position, result);
+    return result;
+}
+
+bool Generator::prefersMove(const Move &move) const
+{
+    if (!m_crossplayEquity) return MoveList::equityComparator(best, move);
+    if (move.equity != best.equity) return move.equity > best.equity;
+    const double raw = QUACKLE_EVALUATOR->equity(m_position, move);
+    const double previous = QUACKLE_EVALUATOR->equity(m_position, best);
+    if (raw != previous) return raw > previous;
+    if (move.score != best.score) return move.score > best.score;
+    if (move.action != best.action) return move.action < best.action;
+    if (move.startrow != best.startrow) return move.startrow < best.startrow;
+    if (move.startcol != best.startcol) return move.startcol < best.startcol;
+    if (move.horizontal != best.horizontal) return move.horizontal < best.horizontal;
+    return move.tiles() < best.tiles();
+}
+
+bool Generator::findScoreAtLeast(int threshold, Move &move)
+{
+	setrecordall(false);
+	m_hasScoreThreshold = true;
+	m_scoreThreshold = threshold;
+	try
+	{
+		move = findstaticbest(false);
+	}
+	catch (const ScoreThresholdFound &found)
+	{
+		m_hasScoreThreshold = false;
+		move = found.move;
+		return true;
+	}
+	m_hasScoreThreshold = false;
+	return false;
+}
