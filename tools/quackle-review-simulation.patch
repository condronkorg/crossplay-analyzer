+// Four conditional opening estimates from the first mover's perspective.
+emscripten::val simulateInitialDeal(std::string firstRack, std::string secondRack,
+                                    double iterationsValue, double seedValue)
+{
+    emscripten::val result = emscripten::val::object();
+    result.set("simulated", false);
+    result.set("samplingVersion", std::string("initial-deal-v1"));
+    result.set("policy", std::string("static-best-v1"));
+    try
+    {
+        if (!s_dm || !s_dm->isGood()) throw std::invalid_argument("Engine not initialized");
+        if (!std::isfinite(iterationsValue) || iterationsValue < 1 || iterationsValue > 277 ||
+            std::floor(iterationsValue) != iterationsValue)
+            throw std::invalid_argument("Simulation iterations must be between 1 and 277");
+        if (!std::isfinite(seedValue) || seedValue < 0 || seedValue > 4294967295.0 || std::floor(seedValue) != seedValue)
+            throw std::invalid_argument("Opening seed must be an unsigned 32-bit integer");
+        const int iterations = static_cast<int>(iterationsValue);
+        const unsigned int seed = static_cast<unsigned int>(seedValue);
+        auto physicalRack = [](std::string &text) {
+            if (text.size() != 7 || !std::all_of(text.begin(), text.end(),
+                [](char c) { return c == '?' || (c >= 'A' && c <= 'Z'); }))
+                throw std::invalid_argument("Each opening rack must contain seven uppercase physical tiles");
+            std::sort(text.begin(), text.end());
+            Quackle::LetterString letters;
+            for (char c : text)
+                letters.push_back(c == '?' ? QUACKLE_BLANK_MARK : charToLetter(c));
+            return Quackle::Rack(letters);
+        };
+        const Quackle::Rack first = physicalRack(firstRack);
+        const Quackle::Rack second = physicalRack(secondRack);
+        Quackle::Bag available;
+        if (!available.removeLetters(first.tiles()) || !available.removeLetters(second.tiles()) || available.size() != 86)
+            throw std::invalid_argument("The opening racks exceed the Crossplay physical tile distribution");
+
+        // addPosition deals temporary racks; each seeded trial replaces the
+        // complete deal before move generation or evaluation.
+        Quackle::Game game;
+        Quackle::PlayerList players;
+        players.push_back(Quackle::Player(MARK_UV("First"), Quackle::Player::HumanPlayerType, 0));
+        players.push_back(Quackle::Player(MARK_UV("Second"), Quackle::Player::HumanPlayerType, 1));
+        game.setPlayers(players);
+        game.addPosition();
+        game.currentPosition().underlyingBoardReference().prepareEmptyBoard();
+        game.currentPosition().setCurrentPlayer(0);
+        Quackle::SimmedMoveConstants constants;
+        constants.game = game;
+        constants.startPlayerId = 0;
+        constants.playerCount = 2;
+        // simulate(2) plays a candidate and two future moves: three total.
+        constants.decimalTurns = 1;
+        constants.levelCount = 1;
+        constants.ignoreOppos = false;
+        constants.isLogging = false;
+        constants.pairedSamples = true;
+        constants.sampleSeed = seed;
+        constants.initialDeal = true;
+        auto estimate = [&](bool fixFirst, bool fixSecond) {
+            constants.firstOpeningRack = fixFirst ? first : Quackle::Rack();
+            constants.secondOpeningRack = fixSecond ? second : Quackle::Rack();
+            double sum = 0;
+            for (int trial = 1; trial <= iterations; ++trial)
+            {
+                Quackle::SimmedMoveMessage message;
+                message.iteration = trial;
+                message.levels.setNumberLevels(constants.levelCount + 1);
+                Quackle::Simulator::simulateOnePosition(message, constants);
+                if (!message.bogowin || !std::isfinite(message.wins) || message.wins < 0 || message.wins > 1)
+                    throw std::invalid_argument("The opening trial did not return a horizon win estimate");
+                sum += message.wins;
+            }
+            return sum / iterations;
+        };
+        const double baseline = estimate(false, false);
+        const double firstOnly = estimate(true, false);
+        const double secondOnly = estimate(false, true);
+        const double joint = estimate(true, true);
+        result.set("firstRack", firstRack);
+        result.set("secondRack", secondRack);
+        result.set("seed", seed);
+        result.set("baselineWin", baseline);
+        result.set("firstOnlyWin", firstOnly);
+        result.set("secondOnlyWin", secondOnly);
+        result.set("afterWin", joint);
+        result.set("firstWpa", 100 * ((firstOnly - baseline) + (joint - secondOnly)) / 2);
+        result.set("secondWpa", -100 * ((secondOnly - baseline) + (joint - firstOnly)) / 2);
+        result.set("iterationsRequested", iterations);
+        result.set("iterationsCompleted", iterations);
+        result.set("plies", 2);
+        result.set("playToEnd", false);
+        result.set("simulationMode", std::string("2-ply"));
+        result.set("winModel", std::string("bogowin"));
+        result.set("simulated", true);
+        result.set("error", std::string(""));
+    }
+    catch (const std::exception &error) { result.set("error", std::string(error.what())); }
+    return result;
+}
