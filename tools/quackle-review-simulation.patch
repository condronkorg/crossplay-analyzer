+unsigned int crossplayLocalSeed(const string &key)
+{
+    unsigned int seed = 2166136261u;
+    for (unsigned char ch : key) seed = (seed ^ ch) * 16777619u;
+    return seed ? seed : 1;
+}
+
+LetterString crossplayLocalDrawingOrder(const Bag &bag, unsigned int &state)
+{
+    // Chance uses its own PRNG. Policy evaluation must not consume the outer
+    // paired simulation's random stream, including on a cache hit.
+    vector<Letter> tiles(bag.tiles().begin(), bag.tiles().end());
+    sort(tiles.begin(), tiles.end());
+    for (size_t i = tiles.size(); i > 1; --i)
+    {
+        state ^= state << 13; state ^= state >> 17; state ^= state << 5;
+        swap(tiles[i - 1], tiles[state % i]);
+    }
+    LetterString result;
+    for (const auto tile : tiles) result.push_back(tile);
+    return result;
+}
+
+double crossplayBaseValue(GamePosition position, const Move &candidate, int actor, unsigned int seed)
+{
+    position = crossplayAfterMove(position, candidate);
+    for (int ply = 0; ply < crossplayBaseMoveLimit && !position.gameOver(); ++ply)
+    {
+        if (!position.bag().empty())
+            position.setDrawingOrder(crossplayLocalDrawingOrder(position.bag(), seed));
+        const Move move = position.bag().empty()
+            ? crossplayFinalMove(position, true) : position.staticBestMove();
+        position = crossplayAfterMove(position, move);
+    }
+    const int spread = position.spread(actor);
+    if (position.gameOver()) return crossplayWinUtility(spread);
+    // Exchanges and passes can prevent depletion. Bound that policy evaluation
+    // and use the existing win model; this is not an exact preempty solver.
+    const int tiles = position.bag().size() + QUACKLE_PARAMETERS->rackSize();
+    return position.currentPlayer().id() == actor
+        ? QUACKLE_STRATEGY_PARAMETERS->bogowin(spread, tiles, 0)
+        : 1.0 - QUACKLE_STRATEGY_PARAMETERS->bogowin(-spread, tiles, 0);
+}
