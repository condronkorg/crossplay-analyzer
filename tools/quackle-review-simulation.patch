+// Physical placements identify a play even when a one-tile play is written in
+// the other direction. Assigned blanks remain different from ordinary tiles.
+std::string physicalMoveKey(const Quackle::Move &move)
+{
+    if (move.action == Quackle::Move::Pass) return "pass";
+    if (move.action == Quackle::Move::Exchange)
+    {
+        std::string tiles = tilesToString(move.tiles());
+        std::sort(tiles.begin(), tiles.end());
+        return "exchange:" + tiles;
+    }
+    std::vector<std::string> placed;
+    int row = move.startrow, col = move.startcol;
+    for (auto letter : move.tiles())
+    {
+        if (letter != QUACKLE_PLAYED_THRU_MARK)
+            placed.push_back(std::to_string(row * 15 + col) + ":" + std::to_string((int)letter));
+        if (move.horizontal) ++col; else ++row;
+    }
+    std::sort(placed.begin(), placed.end());
+    std::string key = "place:";
+    for (const auto &tile : placed) key += tile + ";";
+    return key;
+}
+
+Quackle::Move recordedMove(Quackle::GamePosition &pos, const emscripten::val &played)
+{
+    const std::string action = played["action"].as<std::string>();
+    const std::string tiles = played["tiles"].as<std::string>();
+    const std::string square = played["position"].as<std::string>();
+    Quackle::Move move;
+    if (action == "pass")
+    {
+        if (!tiles.empty() || !square.empty()) throw std::invalid_argument("Pass must have no tiles or position");
+        move = Quackle::Move::createPassMove();
+    }
+    else if (action == "exchange")
+    {
+        if (!square.empty() || tiles.empty() || tiles.size() > 7)
+            throw std::invalid_argument("Exchange requires 1 to 7 recorded tiles and no position");
+        Quackle::LetterString letters;
+        for (char c : tiles)
+        {
+            if (c != '?' && (c < 'A' || c > 'Z'))
+                throw std::invalid_argument("Exchange tiles must be letters or unassigned blanks");
+            letters.push_back(c == '?' ? QUACKLE_BLANK_MARK : charToLetter(c));
+        }
+        std::sort(letters.begin(), letters.end());
+        move = Quackle::Move::createExchangeMove(letters, false);
+    }
+    else if (action == "place")
+    {
+        if (square.size() < 2 || square.size() > 3 || tiles.empty() || tiles.size() > 15)
+            throw std::invalid_argument("Recorded move needs a valid position and tiles");
+        const bool across = square[0] >= '0' && square[0] <= '9';
+        const char column = across ? square.back() : square.front();
+        const std::string rowText = across ? square.substr(0, square.size() - 1) : square.substr(1);
+        if (column < 'A' || column > 'O' || rowText.empty() || rowText[0] == '0' ||
+            !std::all_of(rowText.begin(), rowText.end(), [](char c) { return c >= '0' && c <= '9'; }))
+            throw std::invalid_argument("Recorded move position is outside the board");
+        int row = std::stoi(rowText) - 1, col = column - 'A';
+        const int startRow = row, startCol = col;
+        Quackle::LetterString letters;
+        int placedCount = 0;
+        for (char c : tiles)
+        {
+            if (row < 0 || row >= 15 || col < 0 || col >= 15)
+                throw std::invalid_argument("Recorded move runs outside the board");
+            const auto existing = pos.board().letter(row, col);
+            if (existing != QUACKLE_NULL_MARK)
+            {
+                if (c != '.' && QUACKLE_ALPHABET_PARAMETERS->clearBlankness(charToLetter(c)) !=
+                    QUACKLE_ALPHABET_PARAMETERS->clearBlankness(existing))
+                    throw std::invalid_argument("Recorded move conflicts with a board tile");
+                letters.push_back(QUACKLE_PLAYED_THRU_MARK);
+            }
+            else
+            {
+                const auto letter = charToLetter(c);
+                if (letter == QUACKLE_NULL_MARK)
+                    throw std::invalid_argument("Recorded move needs a letter on each empty square");
+                letters.push_back(letter);
+                ++placedCount;
+            }
+            if (across) ++col; else ++row;
+        }
+        if (!placedCount) throw std::invalid_argument("Recorded move places no tiles");
+        // Extend through adjacent existing letters so validation checks the full word.
+        int fullRow = startRow, fullCol = startCol;
+        while ((across ? fullCol > 0 : fullRow > 0) &&
+               pos.board().letter(fullRow - !across, fullCol - across) != QUACKLE_NULL_MARK)
+        {
+            fullRow -= !across;
+            fullCol -= across;
+            letters = QUACKLE_PLAYED_THRU_MARK + letters;
+        }
+        while (row < 15 && col < 15 && pos.board().letter(row, col) != QUACKLE_NULL_MARK)
+        {
+            letters.push_back(QUACKLE_PLAYED_THRU_MARK);
+            if (across) ++col; else ++row;
+        }
+        move = Quackle::Move::createPlaceMove(fullRow, fullCol, across, letters);
+    }
+    else throw std::invalid_argument("Recorded move must be a placement, pass, or exchange");
+
+    pos.ensureMovePrettiness(move);
+    if (pos.validateMove(move) != Quackle::GamePosition::ValidMove)
+        throw std::invalid_argument("Recorded move is not legal in Quackle's dictionary at this position");
+    pos.scoreMove(move);
+    return move;
+}
