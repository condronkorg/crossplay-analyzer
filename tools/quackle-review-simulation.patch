+emscripten::val nativeTieOrder(const Quackle::MoveList &moves)
+{
+    std::vector<int> indices(moves.size());
+    std::iota(indices.begin(), indices.end(), 0);
+    std::stable_sort(indices.begin(), indices.end(), [&](int left, int right) {
+        return Quackle::MoveList::wordPosComparator(moves[left], moves[right]);
+    });
+    // MoveList::sort reverses the ascending stable order, including exact ties.
+    auto order = emscripten::val::array();
+    for (size_t rank = 0; rank < indices.size(); ++rank)
+        order.set(static_cast<unsigned int>(rank), indices[indices.size() - 1 - rank]);
+    return order;
+}
