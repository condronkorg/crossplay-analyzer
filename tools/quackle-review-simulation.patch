+Move crossplayPreemptyMove(GamePosition &position)
+{
+    const string key = crossplayInformationKey(position);
+    const auto cached = crossplayPreemptyCache.find(key);
+    if (cached != crossplayPreemptyCache.end()) return cached->second;
+
+    MoveList all = crossplayAllMoves(position);
+    const bool canPlace = any_of(all.begin(), all.end(), [](const Move &move) { return move.action == Move::Place; });
+    if (canPlace)
+        all.erase(remove_if(all.begin(), all.end(), [](const Move &move) { return move.action != Move::Place; }), all.end());
+    // A future placement always reduces a nonempty bag. Do not let the bounded
+    // model invent pass/swap cycles while a legal placement can finish the game.
+    const MoveList candidates = crossplayShortlist(all);
+
+    const Bag unseenBag = position.unseenBag();
+    const auto &unseen = unseenBag.tiles();
+    // Enumerate ordered physical bag allocations; equal letter sequences are
+    // combined, preserving multiplicities. The actor does not know this bag.
+    map<string, int> allocations;
+    for (size_t i = 0; i < unseen.size(); ++i)
+    {
+        string allocation(1, static_cast<char>(unseen[i]));
+        if (position.bag().size() == 1) ++allocations[allocation];
+        else for (size_t j = 0; j < unseen.size(); ++j)
+            if (i != j) ++allocations[allocation + static_cast<char>(unseen[j])];
+    }
+    // Small pools are enumerated exactly. Larger pools use the same two
+    // deterministic weighted worlds for every candidate and every outer trial.
+    // The seed uses only actor information, never the actual sampled bag.
+    if (allocations.size() > crossplayPolicyWorlds)
+    {
+        int physicalCount = 0;
+        for (const auto &allocation : allocations) physicalCount += allocation.second;
+        map<string, int> sampled;
+        unsigned int state = crossplayLocalSeed(key);
+        for (int trial = 0; trial < crossplayPolicyWorlds; ++trial)
+        {
+            state ^= state << 13; state ^= state >> 17; state ^= state << 5;
+            int draw = state % physicalCount;
+            for (const auto &allocation : allocations)
+            {
+                draw -= allocation.second;
+                if (draw < 0) { ++sampled[allocation.first]; break; }
+            }
+        }
+        allocations = std::move(sampled);
+    }
+    const int actor = position.currentPlayer().id();
+    Move chosen = candidates.front();
+    double bestValue = -1;
+    for (const auto &candidate : candidates)
+    {
+        double weightedValue = 0;
+        int totalWeight = 0;
+        for (const auto &allocation : allocations) totalWeight += allocation.second;
+        int seenWeight = 0;
+        bool canImprove = true;
+        for (const auto &allocation : allocations)
+        {
+            Bag hidden(unseenBag);
+            LetterString bagLetters;
+            for (unsigned char tile : allocation.first) bagLetters.push_back(static_cast<Letter>(tile));
+            hidden.removeLetters(bagLetters);
+            LetterString hiddenLetters;
+            for (const auto tile : hidden.tiles()) hiddenLetters.push_back(tile);
+            GamePosition scenario(position);
+            for (const auto &player : position.players())
+                if (player.id() != actor) scenario.setPlayerRack(player.id(), Rack(hiddenLetters), false);
+            scenario.setBag(Bag(bagLetters));
+            scenario.setDrawingOrder(bagLetters);
+            const unsigned int seed = crossplayLocalSeed(key + allocation.first);
+            weightedValue += allocation.second * crossplayBaseValue(scenario, candidate, actor, seed);
+            seenWeight += allocation.second;
+            // Unvisited worlds can contribute at most one win each.
+            if (weightedValue + totalWeight - seenWeight <= bestValue * totalWeight + 1e-12)
+            {
+                canImprove = false;
+                break;
+            }
+        }
+        if (!canImprove) continue;
+        const double value = weightedValue / totalWeight;
+        if (value > bestValue + 1e-12)
+        {
+            bestValue = value;
+            chosen = candidate;
+        }
+        if (bestValue >= 1.0 - 1e-12) break;
+    }
+    if (crossplayPreemptyCache.size() >= crossplayPolicyCacheLimit) crossplayPreemptyCache.erase(crossplayPreemptyCache.begin());
+    crossplayPreemptyCache.emplace(key, chosen);
+    return chosen;
+}
+
+Move crossplayFutureMove(GamePosition &position)
+{
+    if (!QUACKLE_PARAMETERS->equalTurnsEndgame() || position.players().size() != 2 || position.bag().size() > 2)
+        return position.staticBestMove();
+    return position.bag().empty() ? crossplayFinalMove(position) : crossplayPreemptyMove(position);
+}
+}
