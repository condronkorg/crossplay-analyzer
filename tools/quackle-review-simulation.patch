+#ifndef QUACKLE_CROSSPLAYCACHE_H
+#define QUACKLE_CROSSPLAYCACHE_H
+
+#include <cstddef>
+#include <iterator>
+#include <list>
+#include <string>
+#include <string_view>
+#include <unordered_map>
+#include <utility>
+
+namespace Quackle
+{
+template <typename Value> class CrossplayLruCache
+{
+public:
+	explicit CrossplayLruCache(std::size_t capacity)
+		: m_capacity(capacity)
+	{
+	}
+	CrossplayLruCache(const CrossplayLruCache &) = delete;
+	CrossplayLruCache &operator=(const CrossplayLruCache &) = delete;
+
+	const Value *find(const std::string &key)
+	{
+		const auto found = m_index.find(key);
+		if (found == m_index.end())
+			return nullptr;
+		m_entries.splice(m_entries.end(), m_entries, found->second);
+		return &found->second->second;
+	}
+
+	void emplace(std::string key, Value value)
+	{
+		if (m_capacity == 0)
+			return;
+		const auto found = m_index.find(key);
+		if (found != m_index.end())
+		{
+			found->second->second = std::move(value);
+			m_entries.splice(m_entries.end(), m_entries, found->second);
+			return;
+		}
+		m_entries.emplace_back(std::move(key), std::move(value));
+		const auto entry = std::prev(m_entries.end());
+		try
+		{
+			m_index.emplace(std::string_view(entry->first), entry);
+		}
+		catch (...)
+		{
+			m_entries.pop_back();
+			throw;
+		}
+		if (m_entries.size() > m_capacity)
+		{
+			m_index.erase(m_entries.front().first);
+			m_entries.pop_front();
+		}
+	}
+
+	std::size_t size() const { return m_entries.size(); }
+
+private:
+	using Entries = std::list<std::pair<std::string, Value>>;
+	const std::size_t m_capacity;
+	Entries m_entries;
+	// Views refer to stable list nodes and are erased before their strings.
+	std::unordered_map<std::string_view, typename Entries::iterator> m_index;
+};
+}
+#endif
