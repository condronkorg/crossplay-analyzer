+// The empty-bag game has at most two moves. Before that phase, use one
+// bounded policy-improvement layer. Its inner final-phase screening is also
+// bounded; actual empty-bag decisions always use the full exact search.
+// Never choose from a sampled true rack.
+constexpr size_t crossplayPolicyCacheLimit = 32768;
+constexpr int crossplayPolicyCandidates = 4;
+constexpr int crossplayPolicyWorlds = 2;
+constexpr int crossplayBaseMoveLimit = 12;
+thread_local unordered_map<string, Move> crossplayFinalCache;
+thread_local unordered_map<string, Move> crossplayPreemptyCache;
+
+void appendLetters(string &key, const LetterString &letters)
+{
+    for (const auto letter : letters) key.push_back(static_cast<char>(letter));
+    key.push_back('\0');
+}
+
+string crossplayInformationKey(const GamePosition &position)
+{
+    string key;
+    key.reserve(576);
+    const auto &board = position.board();
+    for (int row = 0; row < board.height(); ++row)
+        for (int col = 0; col < board.width(); ++col)
+        {
+            key.push_back(static_cast<char>(board.letter(row, col)));
+            key.push_back(board.isBlank(row, col) ? 1 : 0);
+        }
+    appendLetters(key, position.currentPlayer().rack().alphaTiles());
+    key += to_string(position.currentPlayer().id()) + ":";
+    for (const auto &player : position.players())
+        key += to_string(player.id()) + ":" + to_string(player.score()) + ":";
+    key += to_string(position.bag().size()) + ":" + to_string(position.finalTurnsRemaining());
+    return key;
+}
+
+bool stableStaticOrder(const Move &a, const Move &b)
+{
+    if (a.equity != b.equity) return a.equity > b.equity;
+    if (a.score != b.score) return a.score > b.score;
+    if (a.action != b.action) return a.action < b.action;
+    if (a.startrow != b.startrow) return a.startrow < b.startrow;
+    if (a.startcol != b.startcol) return a.startcol < b.startcol;
+    if (a.horizontal != b.horizontal) return a.horizontal < b.horizontal;
+    return a.tiles() < b.tiles();
+}
+
+MoveList crossplayAllMoves(const GamePosition &position)
+{
+    Generator generator(position);
+    // Two requests full recording; allPossiblePlays is the untruncated list.
+    generator.kibitz(2, position.exchangeAllowed() ? Generator::RegularKibitz : Generator::CannotExchange);
+    MoveList moves = generator.allPossiblePlays();
+    bool hasPass = false;
+    for (const auto &move : moves) hasPass |= move.action == Move::Pass;
+    if (!hasPass) moves.push_back(Move::createPassMove());
+    stable_sort(moves.begin(), moves.end(), stableStaticOrder);
+    return moves;
+}
+
+GamePosition crossplayAfterMove(const GamePosition &position, const Move &move)
+{
+    GamePosition next(position);
+    next.setMoveMade(move);
+    next.incrementTurn(nullptr);
+    next.makeMove(move, true);
+    return next;
+}
+
+double crossplayWinUtility(int spread)
+{
+    return spread > 0 ? 1.0 : spread == 0 ? 0.5 : 0.0;
+}
+
+MoveList crossplayShortlist(const MoveList &all)
+{
+    MoveList candidates;
+    bool includedCount[8] = {};
+    int rank = 0;
+    for (const auto &move : all)
+    {
+        const size_t used = move.usedTiles().size();
+        const bool firstCount = used <= 7 && !includedCount[used];
+        if (rank++ < crossplayPolicyCandidates || firstCount || move.action == Move::Pass)
+            candidates.push_back(move);
+        if (used <= 7) includedCount[used] = true;
+    }
+    return candidates;
+}
+
+Move crossplayFinalMove(GamePosition &position, bool boundedScreen = false)
+{
+    if (position.finalTurnsRemaining() != 1 && position.finalTurnsRemaining() != 2)
+        throw invalid_argument("Crossplay empty-bag position is missing its final-turn state");
+    string key = crossplayInformationKey(position);
+    // A bounded inner policy estimate must never populate the exact cache.
+    key.push_back(boundedScreen ? 1 : 0);
+    // In a conserved empty-bag position this rack is already inferable. Include
+    // it explicitly so native callers with synthetic distributions stay safe.
+    for (const auto &player : position.players())
+        if (player.id() != position.currentPlayer().id()) appendLetters(key, player.rack().alphaTiles());
+    const auto cached = crossplayFinalCache.find(key);
+    if (cached != crossplayFinalCache.end()) return cached->second;
+
+    Move chosen;
+    if (position.finalTurnsRemaining() == 1 || boundedScreen)
+        chosen = position.staticBestMove(); // Exact on the last turn; inner screening otherwise.
+    else
+    {
+        const int actor = position.currentPlayer().id();
+        // Avoid recording/sorting every placement for the common easy cases.
+        const Move greedy = position.staticBestMove();
+        chosen = greedy;
+        const int optimistic = position.spread(actor) + greedy.score;
+        GamePosition greedyNext = crossplayAfterMove(position, greedy);
+        const int greedySpread = optimistic - greedyNext.staticBestMove().score;
+        double bestWin = crossplayWinUtility(greedySpread);
+        int bestSpread = greedySpread;
+        if (bestWin < 1 && optimistic >= 0)
+        {
+        const MoveList moves = crossplayAllMoves(position);
+        GamePosition opposing(position);
+        opposing.setCurrentPlayer(position.nextPlayer()->id());
+        const Move priorReply = opposing.staticBestMove();
+        for (const auto &move : moves)
+        {
+            if (move == greedy) continue;
+            // Passing is always available to the final player. Even that reply
+            // defeats these moves; the remaining score-sorted moves cannot win.
+            const int upperSpread = position.spread(actor) + move.score;
+            if (upperSpread < 0 || (upperSpread == 0 && bestWin >= 0.5)) break;
+            GamePosition next = crossplayAfterMove(position, move);
+            // A still-legal high reply is a lower bound on the final player's
+            // score. Test that bound before doing another full move generation.
+            bool priorFits = priorReply.action == Move::Place;
+            int row = priorReply.startrow, col = priorReply.startcol;
+            for (const auto tile : priorReply.tiles())
+            {
+                if (tile != QUACKLE_PLAYED_THRU_MARK && next.board().letter(row, col) != QUACKLE_NULL_MARK)
+                    priorFits = false;
+                row += !priorReply.horizontal; col += priorReply.horizontal;
+            }
+            // Do not reuse a word that the new play extends at either end.
+            const int beforeRow = priorReply.startrow - !priorReply.horizontal;
+            const int beforeCol = priorReply.startcol - priorReply.horizontal;
+            if ((beforeRow >= 0 && beforeCol >= 0 && next.board().letter(beforeRow, beforeCol) != QUACKLE_NULL_MARK) ||
+                (row < next.board().height() && col < next.board().width() && next.board().letter(row, col) != QUACKLE_NULL_MARK))
+                priorFits = false;
+            if (priorFits && next.validateMove(priorReply) == GamePosition::ValidMove)
+            {
+                const int boundedSpread = next.spread(actor) - next.calculateScore(priorReply);
+                if (crossplayWinUtility(boundedSpread) <= bestWin) continue;
+            }
+            const Move reply = next.staticBestMove();
+            const int spread = next.spread(actor) - reply.score;
+            const double win = crossplayWinUtility(spread);
+            if (win > bestWin || (win == bestWin && spread > bestSpread))
+            {
+                bestWin = win;
+                bestSpread = spread;
+                chosen = move;
+            }
+            // Any proved win is optimal for the win-utility objective. This
+            // does not claim the chosen winning move maximizes final margin.
+            if (bestWin == 1) break;
+        }
+        }
+    }
+    if (crossplayFinalCache.size() >= crossplayPolicyCacheLimit) crossplayFinalCache.erase(crossplayFinalCache.begin());
+    crossplayFinalCache.emplace(std::move(key), chosen);
+    return chosen;
+}
