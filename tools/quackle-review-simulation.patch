+emscripten::val planReviewSimulation(std::string gridJson, std::string rackStr, int playerScore, int oppScore,
+    int numMoves, int bagCount, int finalTurnsRemaining, emscripten::val played, unsigned int seed)
+{
+    auto result = emscripten::val::object();
+    try
+    {
+        if (!s_dm || !s_dm->isGood()) throw std::invalid_argument("Engine not initialized");
+        if (numMoves < 1 || numMoves > 15) throw std::invalid_argument("Review candidate count must be between 1 and 15");
+        if (bagCount < 0 || bagCount > 21) throw std::invalid_argument("Terminal review requires zero to 21 bag tiles");
+        s_dm->seedRandomNumbers(seed);
+        Quackle::Game game;
+        std::string error;
+        if (!prepareGame(gridJson, rackStr, playerScore, oppScore, numMoves, bagCount, finalTurnsRemaining, true, game, &error))
+            throw std::invalid_argument(error);
+        auto &pos = game.currentPosition();
+        auto moves = pos.moves();
+        const int actualIndex = played.isNull() || played.isUndefined() ? -1 : appendRecordedCandidate(pos, moves, played);
+        const auto serialized = serializeMoves(moves, pos.currentPlayer().rack(), nullptr);
+        result.set("moves", serialized);
+        result.set("equityMoves", serialized);
+        result.set("bagEmptyingIndices", emscripten::val::array());
+        result.set("tieOrder", nativeTieOrder(moves));
+        result.set("actualIndex", actualIndex);
+        result.set("seed", seed);
+        result.set("bagCount", bagCount);
+        result.set("finalTurnsRemaining", finalTurnsRemaining);
+        result.set("error", std::string(""));
+    }
+    catch (const std::exception &error) { result.set("error", std::string(error.what())); }
+    return result;
+}
