+emscripten::val simulateReviewDraw(std::string gridJson, std::string rackStr, int playerScore, int oppScore,
+                                  int numMoves, int iterations, int bagCount, int finalTurnsRemaining,
+                                  emscripten::val played, double seedValue, std::string rackAfter)
+{
+    emscripten::val result = emscripten::val::object();
+    result.set("simulated", false);
+    result.set("samplingVersion", std::string("rack-draw-v1"));
+    result.set("rackAfter", rackAfter);
+    try
+    {
+        if (!s_dm || !s_dm->isGood()) throw std::invalid_argument("Engine not initialized");
+        if (numMoves < 1 || numMoves > 15) throw std::invalid_argument("Review candidate count must be between 1 and 15");
+        if (iterations < 1 || iterations > 277) throw std::invalid_argument("Simulation iterations must be between 1 and 277");
+        if (!std::isfinite(seedValue) || seedValue < 0 || seedValue > 4294967295.0 || std::floor(seedValue) != seedValue)
+            throw std::invalid_argument("Review seed must be an unsigned 32-bit integer");
+        const unsigned int seed = static_cast<unsigned int>(seedValue);
+        result.set("seed", seed);
+        s_dm->seedRandomNumbers(seed);
+        Quackle::Game game;
+        std::string error;
+        if (!prepareGame(gridJson, rackStr, playerScore, oppScore, numMoves,
+                         bagCount, finalTurnsRemaining, true, game, &error))
+            throw std::invalid_argument(error);
+        Quackle::GamePosition &pos = game.currentPosition();
+        if (bagCount > 0 && rackStr.size() != 7)
+            throw std::invalid_argument("A nonempty bag requires a full mover rack");
+        Quackle::Move actual = recordedMove(pos, played);
+        const std::string actualKey = physicalMoveKey(actual);
+        for (const auto &move : pos.moves())
+            if (physicalMoveKey(move) == actualKey) { actual = move; break; }
+        if (rackAfter.size() > 7 || !std::all_of(rackAfter.begin(), rackAfter.end(),
+            [](char c) { return c == '?' || (c >= 'A' && c <= 'Z'); }))
+            throw std::invalid_argument("The rack after the draw must contain at most seven physical tiles");
+        Quackle::LetterString lettersAfter;
+        for (char c : rackAfter)
+            lettersAfter.push_back(c == '?' ? QUACKLE_BLANK_MARK : charToLetter(c));
+        const Quackle::Rack retained = pos.currentPlayer().rack() - actual;
+        Quackle::Rack drawn(lettersAfter);
+        if (!drawn.unload(retained.tiles()))
+            throw std::invalid_argument("The rack after the draw is missing retained tiles");
+        const int drawCount = actual.action == Quackle::Move::Pass ? 0
+            : std::min(bagCount, 7 - static_cast<int>(retained.size()));
+        if (static_cast<int>(drawn.size()) != drawCount)
+            throw std::invalid_argument("The rack after the draw has the wrong number of new tiles");
+        Quackle::Bag unseen(pos.unseenBag());
+        if (!unseen.removeLetters(drawn.tiles()))
+            throw std::invalid_argument("The recorded draw contains unavailable tiles");
+        const bool playToEnd = bagCount <= 21;
+        const int plies = playToEnd ? -1 : 2;
+        auto estimate = [&](bool conditionDraw) {
+            Quackle::Simulator simulator;
+            simulator.setThreadCount(0);
+            simulator.setPosition(pos);
+            Quackle::MoveList moves;
+            moves.push_back(actual);
+            simulator.setIncludedMoves(moves);
+            simulator.setPairedSampleSeed(seed);
+            simulator.setIgnoreOppos(false);
+            if (conditionDraw) simulator.setFirstDraw(drawn);
+            simulator.simulate(plies, iterations);
+            const auto &simmed = simulator.simmedMoveForMove(actual);
+            if (simulator.iterations() != iterations || simmed.wins.incorporatedValues() != iterations ||
+                (playToEnd && simmed.terminalResults.averagedValue() != 1))
+                throw std::invalid_argument("The rack draw simulation did not finish all requested samples");
+            return simmed.wins.averagedValue();
+        };
+        const double beforeWin = estimate(false);
+        const double afterWin = drawCount == 0 ? beforeWin : estimate(true);
+        emscripten::val selected = emscripten::val::object();
+        selected.set("action", moveActionStr(actual.action));
+        selected.set("position", positionString(actual));
+        selected.set("tiles", tilesToString(actual.prettyTiles()));
+        result.set("selected", selected);
+        result.set("beforeWin", beforeWin);
+        result.set("afterWin", afterWin);
+        result.set("drawCount", drawCount);
+        result.set("iterationsRequested", iterations);
+        result.set("iterationsCompleted", iterations);
+        result.set("bagCount", bagCount);
+        result.set("finalTurnsRemaining", finalTurnsRemaining);
+        result.set("plies", plies);
+        result.set("playToEnd", playToEnd);
+        result.set("simulationMode", std::string(playToEnd ? "play-to-end" : "2-ply"));
+        result.set("winModel", std::string(playToEnd ? "terminal" : "bogowin"));
+        if (playToEnd) result.set("endgamePolicy", std::string("crossplay-endgame-v1"));
+        result.set("simulated", true);
+        result.set("error", std::string(""));
+    }
+    catch (const std::exception &error) { result.set("error", std::string(error.what())); }
+    return result;
+}
